# FedEx Developer API (required) — https://developer.fedex.com
FEDEX_API_KEY=your-fedex-client-id
FEDEX_API_SECRET=your-fedex-client-secret
FEDEX_ACCOUNT_NUMBER=123456789
FEDEX_ENV=sandbox
# FEDEX_API_BASE=https://apis.fedex.com

# Grok analysis (recommended)
XAI_API_KEY=your-xai-api-key
GROK_MODEL=grok-3-mini

# SMS notifications (optional — uses Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
SMS_ENABLED=true

# Server
PORT=3000
DATA_DIR=/data
FOLLOWUP_HOURS=24

# Railway auto-sets RAILWAY_PUBLIC_DOMAIN — only needed for ngrok/local:
# HOSTNAME=https://your-server.ngrok.app

# Phone escalation (optional — not needed for API mode)
# TWILIO_* and HOSTNAME above
# FEDEX_PHONE_NUMBER=+18004633339